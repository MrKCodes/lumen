VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFzbWpxa3V4dmhocHBjd2VhYml5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI1MTY1NzMsImV4cCI6MjEwODA5MjU3M30.UZWT4gH00E0iCeysVZCch5j7HqWr8cfDFp3ze9WN-5Q

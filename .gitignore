# Node / SvelteKit
web/node_modules/
web/.svelte-kit/
web/build/
web/.env
web/.env.*
!web/.env.example
# .env.production holds only the PUBLIC Supabase URL + anon key (safe in the
# browser by design; RLS protects data). Committed so the Cloudflare build is
# self-contained and never breaks on a missing build-time env var.
!web/.env.production

# Go
importer/lumen-import
importer/bin/
*.test

# Secrets — never commit
.env
.env.*
!.env.example
*.local

# Supabase local
supabase/.branches/
supabase/.temp/

# Syncline local state (per its docs: gitignored)
syncline/configs/state/

# OS
.DS_Store
Thumbs.db

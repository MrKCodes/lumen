# Node / SvelteKit
web/node_modules/
web/.svelte-kit/
web/build/
web/.env
web/.env.*
!web/.env.example

# Go
importer/lumen-import
importer/bin/
*.test

# Secrets — never commit
.env
.env.*
!.env.example
*.local

# EXCEPTION: web/.env.production holds ONLY the PUBLIC Supabase URL + anon key.
# This is safe and intentional: the anon key is designed to live in the browser
# (it already ships in the deployed site's JS), and Row-Level Security in Postgres
# is what actually protects data. It is committed so the Cloudflare build is
# self-contained. The SECRET service_role key is NOT here — it stays in the
# untracked root .env, used only by the Go importer. This negation is LAST so it
# wins over the .env.* rule above.
!web/.env.production

# Supabase local
supabase/.branches/
supabase/.temp/

# Syncline local state (per its docs: gitignored)
syncline/configs/state/

# OS
.DS_Store
Thumbs.db

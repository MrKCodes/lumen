# Node / SvelteKit
web/node_modules/
web/.svelte-kit/
web/build/
web/.env
web/.env.*
!web/.env.example

# Go
importer/lumen-import
importer/bin/
*.test

# Secrets — never commit
.env
.env.*
!.env.example
*.local

# EXCEPTION: web/.env.production holds ONLY the PUBLIC Supabase URL + anon key
# (safe in the browser by design; RLS protects data). Committed so the Cloudflare
# build is self-contained. This negation is LAST so it wins over .env.* above.
!web/.env.production

# Supabase local
supabase/.branches/
supabase/.temp/

# Syncline local state (per its docs: gitignored)
syncline/configs/state/

# OS
.DS_Store
Thumbs.db

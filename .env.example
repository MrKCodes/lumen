# ─── Lumen environment ───────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Supabase project — from https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon/public key — safe in the browser, used by the SvelteKit app.
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# service_role key — SECRET. Server/CLI only. Bypasses RLS.
# Used ONLY by the Go importer. Never ship to the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
